{
    "headers": [
        {
            "source": "/robots.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/xml; charset=utf-8"
                }
            ]
        },
        {
            "source": "/llms.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/caracteristicas",
            "destination": "/#caracteristicas",
            "permanent": true
        },
        {
            "source": "/ca/caracteristiques",
            "destination": "/ca#caracteristicas",
            "permanent": true
        },
        {
            "source": "/en/features",
            "destination": "/en#caracteristicas",
            "permanent": true
        },
        {
            "source": "/fr/fonctionnalites",
            "destination": "/fr#caracteristicas",
            "permanent": true
        },
        {
            "source": "/it/funzionalita",
            "destination": "/it#caracteristicas",
            "permanent": true
        },
        {
            "source": "/signup",
            "destination": "/login",
            "permanent": false
        },
        {
            "source": "/register",
            "destination": "/login",
            "permanent": false
        },
        {
            "source": "/features",
            "destination": "/#caracteristicas",
            "permanent": true
        },
        {
            "source": "/pricing",
            "destination": "/precios",
            "permanent": true
        },
        {
            "source": "/about",
            "destination": "/sobre-nosotros",
            "permanent": true
        },
        {
            "source": "/contact",
            "destination": "/contacto",
            "permanent": true
        },
        {
            "source": "/privacy",
            "destination": "/privacidad",
            "permanent": true
        },
        {
            "source": "/terms",
            "destination": "/terminos",
            "permanent": true
        },
        {
            "source": "/explore",
            "destination": "/explorar",
            "permanent": true
        },
        {
            "source": "/use-cases",
            "destination": "/momentos",
            "permanent": true
        },
        {
            "source": "/use-cases/personal",
            "destination": "/momentos/cenas-y-reuniones",
            "permanent": true
        },
        {
            "source": "/use-cases/gastro",
            "destination": "/momentos/supper-clubs-y-gastronomia",
            "permanent": true
        },
        {
            "source": "/use-cases/penas",
            "destination": "/momentos/penas-y-asociaciones",
            "permanent": true
        },
        {
            "source": "/use-cases/wellness",
            "destination": "/momentos/retiros-y-bienestar",
            "permanent": true
        },
        {
            "source": "/use-cases/corporate",
            "destination": "/momentos/eventos-de-empresa",
            "permanent": true
        },
        {
            "source": "/use-cases/life",
            "destination": "/momentos/celebraciones-y-bodas",
            "permanent": true
        },
        {
            "source": "/use-cases/despedidas",
            "destination": "/momentos/despedidas-de-soltera-y-soltero",
            "permanent": true
        },
        {
            "source": "/use-cases/expat",
            "destination": "/momentos/cenas-internacionales-y-friendsgiving",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/app",
            "destination": "/app-shell.html"
        },
        {
            "source": "/app/:path*",
            "destination": "/app-shell.html"
        },
        {
            "source": "/login",
            "destination": "/app-shell.html"
        },
        {
            "source": "/profile",
            "destination": "/app-shell.html"
        },
        {
            "source": "/rsvp/:path*",
            "destination": "/app-shell.html"
        },
        {
            "source": "/lg-hq-admin-2026",
            "destination": "/app-shell.html"
        }
    ],
    "functions": {
        "api/supabase-keepalive.js": {
            "experimentalTriggers": [
                {
                    "type": "schedule/v1beta"
                }
            ]
        }
    },
    "schedules": {
        "supabase-keepalive": {
            "schedule": "17 6 * * *",
            "timezone": "Europe/Madrid",
            "function": "api/supabase-keepalive"
        }
    }
}
